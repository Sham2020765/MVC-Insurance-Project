body {
    background-color: #f0f4f8; 
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
    text-align: center;
    padding: 20px;
}

h1 {
    color: #333;
}

.video-container {
    margin: 20px auto;
}

/* This styles the moving animation box */
#animate-box {
    width: 120px;
    height: 120px;
    background-color: #0078d4;
    color: white;
    line-height: 120px;
    font-weight: bold;
    border-radius: 8px;
    position: relative;
    margin: 30px auto;
}