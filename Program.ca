using System;
using System.Collections.Generic;
using System.ComponentModel.DataAnnotations;
using System.Data.Entity; 

namespace FinalAssignmentEF
{
    public class Student
    {
        [Key]
        public int StudentId { get; set; }
        public string Name { get; set; }
        public string Email { get; set; }
    }

    public class SchoolContext : DbContext
    {
        public DbSet<Student> Students { get; set; }

        public SchoolContext() : base("name=SchoolDbConnectionString")
        {
        }
    }

    public class Program
    {
        public static void Main()
        {
            using (var context = new SchoolContext())
            {
                Console.WriteLine("--- Entity Framework 6 Active ---");
                Console.WriteLine("Inserting a new student record...");

                var student = new Student { Name = "Mohammad", Email = "mohammad@example.com" };
                context.Students.Add(student);
                
                Console.WriteLine("Student record added to context successfully!");
            }
        }
    }
}
