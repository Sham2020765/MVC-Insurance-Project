@model IEnumerable<MVC_Insurance_Project.Models.Insuree>

@{
    ViewBag.Title = "Admin Dashboard";
}

<h2>Admin Panel - Insurance Applications</h2>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email Address</th>
            <th>Calculated Quote</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.EmailAddress</td>
                <td>@string.Format("{0:C}", item.Quote)</td>
            </tr>
        }
    </tbody>
</table>
